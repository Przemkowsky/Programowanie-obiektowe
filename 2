import java.util.ArrayList;
import java.util.List;

// ===== ZADANIE 1 =====
class Uczen {
    private String imie;
    private List<Integer> oceny = new ArrayList<>();

    public Uczen(String imie) {
        this.imie = imie;
    }

    public String getImie() { return imie; }
    public void setImie(String imie) { this.imie = imie; }

    public List<Integer> getOceny() { return oceny; }
    public void setOceny(List<Integer> oceny) { this.oceny = oceny; }

    public void dodajOceny(int... noweOceny) {
        for (int o : noweOceny) oceny.add(o);
    }

    public double obliczSrednia() {
        if (oceny.isEmpty()) return 0.0;
        int suma = 0;
        for (int o : oceny) suma += o;
        return (double) suma / oceny.size();
    }
}

// ===== ZADANIE 2 =====
class WysylaczWiadomosci {
    public void wyslij(String... wiadomosci) {
        for (String w : wiadomosci) System.out.println("[Ogólny]: " + w);
    }
}

class WysylaczEmail extends WysylaczWiadomosci {
    @Override
    public void wyslij(String... wiadomosci) {
        String[] przetworzone = new String[wiadomosci.length];
        for (int i = 0; i < wiadomosci.length; i++) {
            przetworzone[i] = "[EMAIL]: " + wiadomosci[i].toUpperCase();
        }
        super.wyslij(przetworzone);
    }
}

