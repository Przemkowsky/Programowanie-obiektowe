class Postac {
    private String nazwa;
    private int zdrowie;

    public Postac(String nazwa, int zdrowie) {
        this.nazwa = nazwa;
        setZdrowie(zdrowie);
    }

    public String getNazwa() { return nazwa; }
    public void setNazwa(String nazwa) { this.nazwa = nazwa; }

    public int getZdrowie() { return zdrowie; }
    public void setZdrowie(int zdrowie) { this.zdrowie = Math.max(0, zdrowie); }

    public void przedstawSie() {
        System.out.println("Jestem " + nazwa + ", mam " + zdrowie + " HP.");
    }
}

class Mag extends Postac {
    private int mana;

    public Mag(String nazwa, int zdrowie, int mana) {
        super(nazwa, zdrowie);
        this.mana = mana;
    }

    public int getMana() { return mana; }
    public void setMana(int mana) { this.mana = mana; }

    public void rzucCzar(String... cele) {
        StringBuilder sb = new StringBuilder();
        sb.append("[Mag] ").append(getNazwa()).append(" rzuca czar na: ");
        for (int i = 0; i < cele.length; i++) {
            sb.append(cele[i]);
            if (i < cele.length - 1) sb.append(", ");
        }
        System.out.println(sb);
    }
}